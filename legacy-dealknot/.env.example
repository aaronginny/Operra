# Copy to .env for local dev
PORT=3001
JWT_SECRET=change-this-to-a-long-random-string-in-production

# Turso — get these from: turso db show dealknot && turso db tokens create dealknot
TURSO_DATABASE_URL=libsql://your-db-name.turso.io
TURSO_AUTH_TOKEN=your-token-here

# Local dev only (Turso also supports file: for offline dev)
# TURSO_DATABASE_URL=file:local.db
# TURSO_AUTH_TOKEN=   (leave blank for local file)

# Google Places Autocomplete (used by the area input on every form)
# Paste your Google API key here in client/.env so Vite exposes it as VITE_GOOGLE_PLACES_API_KEY.
# When unset, the form falls back to a free-text input — broker can still type any area manually.
VITE_GOOGLE_PLACES_API_KEY=
